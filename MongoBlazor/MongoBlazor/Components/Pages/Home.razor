@page "/"
@using MongoDB.Bson
@using MongoDB.Driver
@inject IMongoClient Client
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-4">
            <label>Datenbank:</label>
            <Selector Names="dbNames" OnSelected="OnDatabaseSelected" Title="Datenbank"></Selector>
        </div>

        <div class="col-md-4">
            <label>Collection:</label>
            <Selector Names="collectionNames" OnSelected="OnCollectionSelected" Title="Collection"></Selector>
        </div>
    </div>

    @if (documents != null && documents.Any())
    {
        <table class="table mt-4">
            <thead>
                <tr>
                    @foreach (var head in headers)
                    {
                        <th>@head</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in documents)
                {
                    <tr>
                        @foreach (var head in headers)
                        {
                            <td>@(doc.Contains(head) ? doc[head].ToString() : "")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<string> dbNames = new();
    private List<string> collectionNames = new();
    private List<BsonDocument> documents = new();
    private HashSet<string> headers = new();
    private string selectedDb = "";

    protected override async Task OnInitializedAsync()
    {
        // Lädt die Liste der Datenbanken beim Start
        using var cursor = await Client.ListDatabaseNamesAsync();
        dbNames = await cursor.ToListAsync();
    }

    private async Task OnDatabaseSelected(ChangeEventArgs e)
    {
        selectedDb = e.Value?.ToString() ?? "";
        collectionNames.Clear();
        documents.Clear();

        if (!string.IsNullOrEmpty(selectedDb))
        {
            // Lädt die Collections für die ausgewählte Datenbank
            var db = Client.GetDatabase(selectedDb);
            using var cursor = await db.ListCollectionNamesAsync();
            collectionNames = await cursor.ToListAsync();
        }
    }

    private async Task OnCollectionSelected(ChangeEventArgs e)
    {
        var selectedColl = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(selectedDb) && !string.IsNullOrEmpty(selectedColl))
        {
            var collection = Client.GetDatabase(selectedDb).GetCollection<BsonDocument>(selectedColl);
            documents = await collection.Find(new BsonDocument()).ToListAsync();

            // Erstellt die Spaltenliste durch Scannen der Dokumente
            headers.Clear();
            foreach (var doc in documents)
            {
                foreach (var elem in doc.Elements)
                {
                    headers.Add(elem.Name);
                }
            }
        }
    }
}