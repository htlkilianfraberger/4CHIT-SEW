<InputSelect ValueExpression="@(() => Selected)"
             Value="@Selected"
             ValueChanged="@((s) => OnInputChanged(s))"
             class="form-select mb-3"
             disabled="@Disabled">
             
    <option value="">-- auswählen --</option>
    @if (DisplayNames != null)
    {
        @foreach (var name in DisplayNames)
        {
            <option value="@name">@name</option>
        }
    }
</InputSelect>

@code {
    [Parameter] public string? Selected { get; set; }
    [Parameter] public List<string>? DisplayNames { get; set; }
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    
    [Parameter] public EventCallback<string?> SelectedChanged { get; set; }
    
    [Parameter] public bool Disabled { get; set; }

    private async Task OnInputChanged(string newValue)
    {
        Selected = newValue;
        
        await SelectedChanged.InvokeAsync(newValue);

        await OnChanged.InvokeAsync(newValue);
    }
}